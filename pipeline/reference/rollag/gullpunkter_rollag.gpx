<?xml version="1.0" encoding="UTF-8"?>
<gpx version="1.1" creator="gullkart-rollag" xmlns="http://www.topografix.com/GPX/1/1">
  <wpt lat="59.9387" lon="9.3361"><name>1 A – Djupdalsjuvet – rett nedenfor Djupdalsdammen</name><desc>De gamle Djupedalsfallene (16 m fall). Regulert 1976, minstevann og terskler. Fjell i dagen – grav i sprekker på tvers av strømmen og bak store steiner, helt ned til fjell.</desc></wpt>
  <wpt lat="59.935" lon="9.3305"><name>2 A – Kvernhusroe / Helle-svingen</name><desc>Gammelt kvernhus = naturlig fall/stryk før regulering. Innersving midt i juvet, nedstrøms terskelen.</desc></wpt>
  <wpt lat="59.9555" lon="9.309"><name>3 A – Rudstryken / Storåe-osen</name><desc>Stryk der Storåe (fra Sørkjevatn og kvartsittfjella) kommer inn. Bankehode og innersving ved Skjærøye/Lomholmen rett nedenfor.</desc></wpt>
  <wpt lat="59.9534" lon="9.3209"><name>4 A – Åjuvet</name><desc>Trangt juv med fjell i dagen rett etter stryket – jettegryter, sprekker og bakevjer.</desc></wpt>
  <wpt lat="59.9489" lon="9.3386"><name>5 A – Ulvikhølen</name><desc>Dyp høl i 90-graders sving ut av juvet. Nedstrøms kant av hølen og innersvingen.</desc></wpt>
  <wpt lat="60.0466" lon="9.1515"><name>6 A – Mykstufoss – nedenfor dammen</name><desc>Hovedfossen i Rollag (amtskartet: 'Møklestue'). Regulert 1964, minstevann. Fossekulp og fjellhyller like nedenfor.</desc></wpt>
  <wpt lat="60.0474" lon="9.1595"><name>7 A – Nørdsteåe-osen ved Veggli</name><desc>Sideelv fra kvartsittfjella inn 500 m nedenfor fossen. Amtskartet viser 'Kvernhus' ved Kirkejord på samme elv.</desc></wpt>
  <wpt lat="60.0684" lon="9.1196"><name>8 A – Trollhøl – under Kjerredammen</name><desc>Kulp der Lågen forlater Kjerre og går inn i den trange strekningen. Minstevann siden 1964 – gammelt elveleie tilgjengelig.</desc></wpt>
  <wpt lat="60.0535" lon="9.1385"><name>9 A – Juvet Tveitkøse–Gardar</name><desc>Bratteste og trangeste strekning i Lågen i Rollag (mesteparten av 62 m fall). Innersvinger og fjellsprekker.</desc></wpt>
  <wpt lat="59.935" lon="9.2824"><name>10 B – Søysetfossen (Storåe)</name><desc>Foss på Storåe 2,5 km opp fra Lågen. Kulpen under fossen og fjellet rett nedenfor.</desc></wpt>
  <wpt lat="60.0919" lon="9.1152"><name>11 B – Helveteshølet / Bratterudfossen (Vergja)</name><desc>Foss med kulp på Vergja fra Vegglifjell, ca. 1 km før Lågen ved Kvisle.</desc></wpt>
  <wpt lat="60.0191" lon="9.1409"><name>12 B – Haugefoss (Medåe)</name><desc>Foss på Medåe, som drenerer kvartsittområdet ved Skinntjønnjuvet og går i Lågen øst for Veggli. Kulp og fjell under fossen.</desc></wpt>
  <wpt lat="60.04" lon="9.1973"><name>13 B – Tondra-osen</name><desc>Tondra/Langvassåe fra Vegglifjell inn i Lågen rett etter kraftverksutløpet. Grus i osen.</desc></wpt>
  <wpt lat="59.914" lon="9.351"><name>14 C – Holmane nedenfor Fossan</name><desc>Første grusøyer etter juvet. Hodet (oppstrøms ende) av bankene ved lavvann – finkorna gull.</desc></wpt>
  <wpt lat="59.997" lon="9.2745"><name>15 C – Øyene sør for Rollag (Ulstadøy/Killingfetøy)</name><desc>Ulstadåe fra Trollumjuvet kommer inn her. Bankehoder – lett tilgjengelig, men lav sannsynlighet.</desc></wpt>
</gpx>